<%= link_to "← User details", user_path(@user) %>
<div class="page-heading">
  <div><h1>Posts</h1><p>For <%= @user.name %></p></div>
  <%= link_to "New post", new_user_post_path(@user), class: "button" %>
</div>
<% if @posts.any? %>
  <div class="table-wrap"><table>
    <thead><tr><th>Title</th><th>Content</th><th>Actions</th></tr></thead>
    <tbody>
      <% @posts.each do |record| %>
        <tr><td><%= record.title %></td><td><%= record.content %></td><td><div class="actions">
          <%= link_to "View", user_post_path(@user, record) %>
          <%= link_to "Edit", edit_user_post_path(@user, record) %>
          <%= button_to "Delete", user_post_path(@user, record), method: :delete, class: "danger", form: { data: { turbo_confirm: "Delete this post?" } } %>
        </div></td></tr>
      <% end %>
    </tbody>
  </table></div>
<% else %>
  <div class="panel"><p>No posts yet.</p></div>
<% end %>
