<% content_for :title, "Users | My Mongo App" %>
<div class="page-heading">
  <div><h1>Users</h1><p>Manage people, their posts, and their addresses.</p></div>
  <%= link_to "New user", new_user_path, class: "button" %>
</div>
<% if @users.any? %>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Age</th><th>Actions</th></tr></thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= link_to user.name, user %></td>
            <td><%= user.email %></td>
            <td><%= user.age || "—" %></td>
            <td class="actions"><%= link_to "Edit", edit_user_path(user) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="panel"><p>No users yet. Create a user to get started.</p></div>
<% end %>
